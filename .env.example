NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Served on its own server, never routed by the load balancer (spec 007, SEC-R43).
METRICS_PORT=9464

# Local Docker Compose services (compose.yaml). Postgres is published on 55432
# so it does not clash with a native Postgres on 5432.
# The service and its scripts connect as the runtime role scf_app; migrations run as the
# owner role scf_owner (ADR-0018, DEP-R05). Roles are created by docker/postgres/init.
DATABASE_URL=postgres://scf_app:scf_app_local_only@127.0.0.1:55432/supercool_dev
MIGRATION_DATABASE_URL=postgres://scf_owner:scf_owner_local_only@127.0.0.1:55432/supercool_dev
TEST_DATABASE_URL=postgres://scf_app:scf_app_local_only@127.0.0.1:55432/supercool_test
TEST_MIGRATION_DATABASE_URL=postgres://scf_owner:scf_owner_local_only@127.0.0.1:55432/supercool_test
REDIS_URL=redis://127.0.0.1:6379

# HS256 signing key. npm run env:sync fills it with a random value; to generate one by hand:
#   openssl rand -base64 48
JWT_SECRET=change-me
JWT_ISSUER=supercool-finances-local
JWT_AUDIENCE=supercool-finances-api

# HMAC key of pagination cursors, at least 32 bytes and different from JWT_SECRET (spec 001).
# npm run env:sync fills it with a random value.
CURSOR_SECRET=change-me

# Pool, timeouts and shutdown (section 1.2 of spec 007), at their defaults. REQUEST_TIMEOUT_MS must
# exceed DB_POOL_ACQUIRE_TIMEOUT_MS + REDIS_COMMAND_TIMEOUT_MS
# + 3 × (IDEMPOTENCY_WAIT_TIMEOUT_MS + 2 × ACCOUNT_LOCK_TIMEOUT_MS) + 30, and SHUTDOWN_TIMEOUT_MS
# must not be below it, or the service refuses to start (SEC-R35).
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=100
REQUEST_TIMEOUT_MS=25000
SHUTDOWN_DRAIN_DELAY_MS=2000
SHUTDOWN_TIMEOUT_MS=30000

# Per-user rate limit, counted in Redis: requests per window of seconds (SEC-R03).
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW_S=10

# Comma-separated CIDR blocks of the proxies whose X-Forwarded-For is trusted; empty trusts none.
TRUSTED_PROXY_CIDRS=
# Comma-separated exact origins allowed by CORS (http:// only outside production); empty turns CORS off.
CORS_ORIGINS=

# Error reporting of the 500s to a Sentry-compatible endpoint (section 1.10 of spec 007); empty
# turns it off. https://<public key>@<host>/<project id>, or http:// only for a loopback host.
SENTRY_DSN=
