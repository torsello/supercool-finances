NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Docker Compose services (compose.yaml). Postgres is published on 55432
# so it does not clash with a native Postgres on 5432.
DATABASE_URL=postgres://scf:scf_local_only@127.0.0.1:55432/supercool_dev
TEST_DATABASE_URL=postgres://scf:scf_local_only@127.0.0.1:55432/supercool_test
REDIS_URL=redis://127.0.0.1:6379

# HS256 signing key. npm run env:sync fills it with a random value; to generate one by hand:
#   openssl rand -base64 48
JWT_SECRET=change-me
